DISCORD_TOKEN=
PREFIX=!
# Optional: restrict commands to one Discord server.
GUILD_ID=
# Optional comma-separated channel IDs; blank permits all channels.
ALLOWED_CHANNEL_IDS=
REFRESH_SECONDS=30
MAX_WATCHES=20
# Optional: kickoff-time display zone for !nfl games / boxscores (IANA name).
GAMES_TIME_ZONE=Europe/Dublin
# Optional: use an existing Chrome instead of Puppeteer's downloaded browser.
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
