DISCORD_TOKEN=
PREFIX=!
# Optional home server; public installs still work in other servers.
GUILD_ID=
# Set true only for a private, single-server bot (requires GUILD_ID).
RESTRICT_TO_GUILD=false
# Optional home-server channel IDs (global if GUILD_ID is blank); threads included.
ALLOWED_CHANNEL_IDS=
REFRESH_SECONDS=30
MAX_WATCHES=20
# Optional: use an existing Chrome instead of Puppeteer's downloaded browser.
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
