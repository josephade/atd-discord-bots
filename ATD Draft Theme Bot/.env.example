DISCORD_TOKEN=
DISCORD_GUILD_ID=
ADMIN_CHANNEL_ID=

# Discord user ID allowed to run owner-only commands (e.g. !allteams).
# Defaults to 681833601830354944 in config.py if left blank.
OWNER_ID=

# Discord user ID of ATD Timer Bot (Anonymous Draft themes only) — used to
# recognize its "your turn" pings in the selection channel.
TIMER_BOT_ID=

# This bot's own Discord user ID (Anonymous Draft themes only). Also needs
# to be added to EXTRA_TRUSTED_BOT_IDS in Timer Bot / Sheet Bot / Team Sheet
# Bot's own .env files so they accept picks this bot posts.
SELF_BOT_ID=

# Player pool / ADP sheet (reuse ATD Draft Bot's pool spreadsheet)
POOL_SPREADSHEET_ID=
POOL_TAB_NAME=ADP

# Team sheet (reuse ATD Team Sheet Bot's spreadsheet)
ROSTER_SPREADSHEET_ID=
ROSTER_TAB_NAME=Draft Results

# Local run only — omit on Fly.io, where GOOGLE_SERVICE_ACCOUNT_JSON is set
# as a secret and STATE_DIR points at the mounted volume instead.
STATE_DIR=.
