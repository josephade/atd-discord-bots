# Required. Use long random values, for example from: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing SESSION_SECRET ends every session and breaks every resume link.
SESSION_SECRET=
IP_HASH_SALT=

# Required for the admin page at /admin.
ADMIN_PASSWORD=

# The public address used in resume links. Leave blank for local testing.
PUBLIC_BASE_URL=

# Set to 0 for local testing over http.
COOKIE_SECURE=0

# Optional: Continue Later email. Without these, voters can still copy their link.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: Google Sheets export. Create an empty spreadsheet and share it with the service account as an editor.
EXPORT_SPREADSHEET_ID=
# Either the JSON itself (for Fly secrets) or a local file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
SERVICE_ACCOUNT_FILE=
